# Copy to .env and fill in. NEVER commit .env
# --- Option A: SendGrid (recommended for bots, free 100 emails/day) ---
# Create a free account at https://sendgrid.com, verify a sender email, then create an API key.
CINEBOT_SENDGRID_API_KEY=your_sendgrid_api_key
CINEBOT_SENDGRID_FROM=your_verified_sender@example.com
CINEBOT_EMAIL_TO=ae3411102@gmail.com

# --- Telegram (free, instant, no signup hassle) ---
# 1. Open Telegram, search @BotFather, send /newbot, follow prompts -> get bot token.
# 2. Send any message to your new bot.
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates in browser -> copy "chat":{"id":...}.
CINEBOT_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
CINEBOT_TELEGRAM_CHAT_ID=123456789

# --- Option B: SMTP (Gmail/Outlook/etc.) ---
# CINEBOT_SMTP_HOST=smtp.gmail.com
# CINEBOT_SMTP_PORT=587
# CINEBOT_SMTP_USER=your_email@gmail.com
# CINEBOT_SMTP_PASSWORD=your_app_password
# CINEBOT_EMAIL_TO=your_email@gmail.com
# CINEBOT_SMTP_USE_TLS=true

# Polling
CINEBOT_POLL_INTERVAL=60
CINEBOT_WATCH_TIMEOUT=0

# Browser
CINEBOT_HEADLESS=true
CINEBOT_CHROME_BINARY=
CINEBOT_POOL_SIZE=2

# Favorite rows (comma-separated row numbers, e.g. "5,6,7")
# CINEBOT_FAVORITE_ROWS=5,6,7
